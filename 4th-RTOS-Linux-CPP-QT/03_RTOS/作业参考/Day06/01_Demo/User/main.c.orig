#include "stm32f10x.h"
#include "FreeRTOS.h"
#include "task.h"
#include "UART1.h"

void task1(void  *p){

	while(1){
		printf1("task1 \r\n");
	}
}
void task2(void  *p){

	while(1){
		printf1("task2 \r\n");
	}
}
void task3(void  *p){

	while(1){
		printf1("task3 \r\n");
	}
}


int main(){
	USART1_Init();
	
	xTaskCreate(task1,"Task1",configMINIMAL_STACK_SIZE,NULL,2,NULL);
		xTaskCreate(task2,"Task2",configMINIMAL_STACK_SIZE,NULL,2,NULL);
		xTaskCreate(task3,"Task3",configMINIMAL_STACK_SIZE,NULL,2,NULL);
	vTaskStartScheduler();
	
}


